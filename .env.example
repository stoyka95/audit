# Volitelné. Bez klíče se PageSpeed Insights volá anonymně — funguje to,
# ale platí výrazně nižší limit požadavků (a při jeho překročení vrací HTTP 429).
# Klíč se zdarma vytvoří v Google Cloud Console: povolte "PageSpeed Insights API"
# a v sekci Credentials vygenerujte API key.
GOOGLE_PAGESPEED_API_KEY=

# Volitelné. ID kontejneru Google Tag Manageru (GTM-XXXXXXX) —
# tagmanager.google.com, nahoře vedle názvu kontejneru. GA4 i další tagy se
# přidávají uvnitř GTM, ne tady. Bez něj se GTM vůbec nenačte, i kdyby
# návštěvník odsouhlasil cookies.
NEXT_PUBLIC_GTM_ID=

# Volitelné. Trvalé počítadlo spuštěných auditů pro patičku. Funguje s Vercel KV
# i s Upstash Redisem — obojí mluví stejným REST protokolem, stačí jedna dvojice.
# Bez nich se audity počítají jen v paměti instance a patička počet vůbec neukáže.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
